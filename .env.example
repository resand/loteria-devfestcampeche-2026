# Copia a .env  →  cp .env.example .env
# --- Local: sin GEMINI_API_KEY corre en MODO ENSAYO (no gasta nada) ---
# GEMINI_API_KEY=            # de https://aistudio.google.com/apikey (opcional, en local; ojo: los créditos de Google Cloud NO aplican a AI Studio)
# O mejor, en local usa Vertex AI con los créditos de tu proyecto (lo mismo que en la nube):
#   gcloud auth application-default login   # una vez, con tu Gmail personal
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=tu-proyecto
# GOOGLE_CLOUD_LOCATION=global

# --- Nube (lo usa scripts/deploy.sh) ---
PROJECT=                     # id de tu proyecto de Google Cloud
REGION=us-central1
CREDITS_URL=                 # link de canje de créditos que te da Google
CREDITS_URL_BACKUP=          # link de respaldo (-bkp): se activa desde /host → Más…
REPO_URL=https://github.com/resand/loteria-devfestcampeche-2026
GOOGLE_CLIENT_ID=            # opcional: login con Google (ver TALLER.md). Vacío = entran con nombre
HOST_EMAILS=                 # si usas login: correos que pueden abrir /host, separados por coma
HOST_KEY=                    # si NO usas login: llave para abrir /host?key=...
MAX_CARDS=400               # tope de cartas = tope de gasto. ~$0.04 c/u (imagen+verso+voz). 400 ≈ $16, 120 ≈ $5
BILLING_ACCOUNT=            # opcional: solo si despliegas sobre la cuenta “GDP Event Credit” del crédito (lo típico al replicar). Vacío = usa la que ya esté ligada (tu facturación)

# Voz del gritón: VOICE (Puck alegre · Fenrir enérgica · Orus grave · Kore femenina) y TTS_STYLE (dirección de estilo, en español)
# VOICE=Puck
# TTS_STYLE=Gritón de lotería de feria mexicana: voz alegre, con mucha energía, alargando las vocales del título como pregonero

# Modelos (verificados oct 2026; cámbialos si salen nuevos)
# MODEL_IMAGE=gemini-nano-banana-2.1
# MODEL_TEXT=gemini-3.5-flash-lite
# MODEL_TTS=gemini-3.8-flash-tts

# --- Avanzado / pruebas (normalmente no se tocan) ---
# CONCURRENCY=6              # cartas que Gemini dibuja en paralelo (súbelo si tu cuota de imágenes lo permite)
# ALLOW_GUEST=1              # en la nube: permitir entrar solo con nombre (prueba de carga). En local ya está activo con `make run`
# MOCK=1                     # modo ensayo: sin Gemini, cartas y voz falsas, no gasta
# MOCK_BUSY=30               # (con MOCK) las primeras 30 cartas rebotan como “Gemini saturado” para ensayar los reintentos
# SESSION_SECRET=            # lo genera deploy.sh solo la primera vez; no lo pongas a mano
